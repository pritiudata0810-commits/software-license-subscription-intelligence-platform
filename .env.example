# PostgreSQL Database URL (Neon / Supabase / Local PostgreSQL)
# Direct connection or pooled connection
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Authentication secret for JWT cookie signing
AUTH_SECRET="your-super-secure-32-byte-hex-secret"

# Application public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python FastAPI Internal Microservice URL (optional, fallback to native engine)
FASTAPI_INTERNAL_URL="http://127.0.0.1:8000"

# Node environment
NODE_ENV="development"
